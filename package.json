{
  "name": "ttrp-tools",
  "version": "0.1.0",
  "private": true,
  "description": "SDK, песочница и примеры встраиваемых инструментов TtRP (Time to Roleplay)",
  "homepage": "https://timetoroleplay.ru",
  "license": "Apache-2.0",
  "author": "ООО «ТАЙМ ТУ РОЛЕПЛЕЙ»",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
