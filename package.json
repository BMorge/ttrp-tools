    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/three": "^0.186.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
